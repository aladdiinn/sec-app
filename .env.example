# ==============================================================================
# BSmart SOC Command Center — Production Environment Configuration Template
# COPY THIS FILE MANUALLY TO /opt/soc/.env ON THE PRODUCTION SERVER
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT OR DOCKER IMAGES (chmod 600 /opt/soc/.env)
# ==============================================================================

# ── 1. Database Configuration (Required) ──────────────────────────────────────
# Hostname or IP of PostgreSQL:
# - If PostgreSQL runs on the host server: use "host.docker.internal"
# - If PostgreSQL runs in Docker container: use "postgres"
# - If PostgreSQL runs on a separate DB server: use the private subnet IP
DB_HOST=host.docker.internal

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database name
DB_NAME=bsmart_soc

# Database username
DB_USER=socadmin

# Database password (REQUIRED - generate with `openssl rand -base64 24`)
DB_PASSWORD=replace_with_strong_database_password_here

# PostgreSQL connection string (alternative to individual DB_* parameters)
# DATABASE_URL=postgresql://socadmin:replace_with_strong_password@host.docker.internal:5432/bsmart_soc

# Strict database enforcement (true: fail if PostgreSQL offline; false: allow local SQLite fallback)
REQUIRE_POSTGRES=true

# ── 2. Security & Session Authentication (Required) ───────────────────────────
# Random 64-character cryptographic secret for signing session cookies and HMAC tokens (REQUIRED)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_random_64_character_hex_secret_key_here

# Require HTTPS for session cookies (true for production HTTPS reverse proxy)
SECURE_COOKIES=true

# Password hashing algorithm (enforce strong salted bcrypt)
ENABLE_BCRYPT=true

# ── 3. Network Access & Reverse Proxy Controls ────────────────────────────────
# Admin IP Allowlist: Comma-separated list of allowed IPs or CIDR blocks for UI & login
# Leave empty to allow any IP (recommended to set to corporate VPN or office static IP)
ADMIN_ALLOWED_IPS=

# Trusted Reverse Proxy IPs: Comma-separated list of IPs allowed to set X-Forwarded-For (Nginx/HAProxy)
TRUSTED_PROXIES=127.0.0.1,::1,172.17.0.1,172.18.0.1

# Application HTTP port inside container (default: 8000)
PORT=8000

# Environment mode (production, staging, development)
ENVIRONMENT=production

# ── 4. Logging & Persistent File Storage ──────────────────────────────────────
# Application log level (INFO, WARNING, ERROR, DEBUG)
LOG_LEVEL=INFO

# Persistent rotated application log file path (mounted on volume /opt/soc/logs)
LOG_FILE_PATH=/app/logs/app_security.log

# Offline MaxMind GeoIP database file path (mounted on volume /opt/soc/data)
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# Skip automatic GeoIP background download in air-gapped / isolated environments
SKIP_GEOIP_DOWNLOAD=false

# ── 5. AI / LLM Incident Analysis (Optional) ──────────────────────────────────
# Google Gemini API key for automated SOC triage, explanation, and threat correlation
GEMINI_API_KEY=

# Gemini primary and fallback models
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-pro

# ── 6. AWS S3 Log Archival & SES Email Alerts (Optional) ───────────────────────
# AWS IAM credentials for cold log archival and critical alert dispatch
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# S3 bucket for long-term raw telemetry compliance retention
AWS_S3_BUCKET_NAME=

# Amazon SES email alerting addresses
SES_SENDER_EMAIL=
SES_RECIPIENT_EMAIL=
