# ==============================================================================
# BSmart SOC Command Center — Environment Configuration Template
# Copy this file to .env and configure strong values before starting containers
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_DB=bsmart_soc
POSTGRES_USER=socadmin
# Set a strong alphanumeric password (e.g. openssl rand -base64 24)
POSTGRES_PASSWORD=replace_with_strong_database_password_2026

# FastAPI Application Settings
# Secret key used for signing session cookies and HMAC tokens
SECRET_KEY=replace_with_random_64_character_secret_key

# Admin Allowlist (CIDR or IP list, comma-separated)
# Leave empty to allow any IP (recommended to set to corporate VPN/static IP)
ADMIN_ALLOWED_IPS=

# Password Hashing Strategy
ENABLE_BCRYPT=true

# Container Image Registry (Used by GitHub Actions and Docker Compose)
# Example: ghcr.io/aladdiinn/sec-app:latest
DOCKER_IMAGE=ghcr.io/aladdiinn/sec-app:latest

# HAProxy Stats UI Credentials (accessed at https://your-server-ip:8404/stats)
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=replace_with_strong_stats_password
