# ─── BSMART SOC Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in real values before running.

# ─── FastAPI Application Server ──────────────────────────────────────────────
SECRET_KEY=ec2-security-monitor-production-secret-key-2026
DEBUG=false
PORT=8000
APP_BRAND=bSmart SOC
APP_VERSION=1.6.0

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
# Local development default:
DATABASE_URL=postgresql://securepulse:securepulse_pass@127.0.0.1:5432/securepulse_db

# Production Cloud RDS / External PostgreSQL:
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ─── Initial Admin Credentials ───────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@bsmartsoc.local
DEFAULT_ADMIN_PASSWORD=Admin@1234

# ─── Server Agent API Key ────────────────────────────────────────────────────
# Server agents must send this key in X-API-Key header to register.
AGENT_API_KEY=sp-agent-key-9f2a8c1b5d3e7f0a4c6b8d2e1f5a9c3b

# ─── Fleet Monitoring Thresholds ─────────────────────────────────────────────
# Seconds before an asset is marked offline if no heartbeat is received
HEARTBEAT_TIMEOUT=120

# ─── AWS SES (Email Alert Notifications) ─────────────────────────────────────
# If left blank, boto3 will attempt EC2 IAM Instance Profile / default credentials.
SES_AWS_REGION=ap-south-1
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_SENDER_EMAIL=alerts@yourcompany.com
SES_RECIPIENT_EMAIL=soc-team@yourcompany.com

# ─── AWS S3 (Log Archiving & Long-Term Retention) ────────────────────────────
# Supports both AWS_S3_* specific keys and standard AWS_* environment credentials:
AWS_S3_REGION=ap-south-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=securepulse-logs-archive-bucket-2026

# ─── Gemini AI (Automated Incident Analysis & Recommendations) ───────────────
GEMINI_API_KEY=
