# ─── SecurePulse Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in real values before running.

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=3f8a21c7b9d04e6f1a5c8b2d9e7f3041a6b8c2d5e9f1a3c7b0d4e6f2a8c1b5d
DEBUG=false
PORT=5000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql+psycopg://securepulse:securepulse_pass@localhost:5432/securepulse_db

# Antigravity / cloud (replace with your actual values):
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@securepulse.local
DEFAULT_ADMIN_PASSWORD=Admin@1234

# ─── Agent API Key ────────────────────────────────────────────────────────────
# Agents must send this key in X-API-Key header to register.
# Change this to a strong random value in production.
AGENT_API_KEY=sp-agent-key-9f2a8c1b5d3e7f0a4c6b8d2e1f5a9c3b

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Seconds before a server is marked offline if no heartbeat received
HEARTBEAT_TIMEOUT=120