# Version control
.git
.github

# Secrets and environment configs (CRITICAL: Never copy into Docker image)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Tests and temporary patch scripts
tests/
scripts_patch/
scratch/
.system_generated/
tmp*

# Persistent database storage & volume mounts (CRITICAL: Never copy host database into image)
SOC-DB/
SOC-APP/
postgres/
*.sql
dump.sql
data/

# Logs and SQLite databases
logs/
*.log
app.log
securepulse.db
*.db
*.sqlite3
